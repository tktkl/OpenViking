+// Copyright (c) 2026 Lark Technologies Pte. Ltd.
+// SPDX-License-Identifier: MIT
+
+package api
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/larksuite/cli/errs"
+	"github.com/larksuite/cli/internal/cmdutil"
+	"github.com/larksuite/cli/internal/core"
+	"github.com/larksuite/cli/internal/httpmock"
+	larkcore "github.com/larksuite/oapi-sdk-go/v3/core"
+)
+
+func TestHeadersStdinPreservesUserIdentity(t *testing.T) {
+	f, out, _, reg := cmdutil.TestFactory(t, &core.CliConfig{
+		AppID: "test-app", AppSecret: "test-secret", Brand: core.BrandFeishu,
+	})
+	f.IOStreams.In = strings.NewReader(`{"X-Lark-Helpdesk-Authorization":"private-header"}`)
+	stub := &httpmock.Stub{Method: "PUT", URL: "/open-apis/helpdesk/v1/tickets/123",
+		Body: map[string]any{"code": 0, "data": map[string]any{}}}
+	reg.Register(stub)
+	cmd := newTestApiCmd(f, nil)
+	cmd.SetArgs([]string{"PUT", "/open-apis/helpdesk/v1/tickets/123", "--headers", "-",
+		"--data", `{"status":51,"solved":2}`, "--as", "user"})
+	if err := cmd.Execute(); err != nil {
+		t.Fatal(err)
+	}
+	if stub.CapturedHeaders.Get("X-Lark-Helpdesk-Authorization") != "private-header" ||
+		stub.CapturedHeaders.Get("Authorization") != "Bearer test-token" {
+		t.Fatal("custom header or CLI-owned authorization was lost")
+	}
+	if !strings.Contains(out.String(), `"identity": "user"`) {
+		t.Fatalf("expected user envelope: %s", out.String())
+	}
+	if strings.Contains(out.String(), "private-header") {
+		t.Fatal("header secret leaked in success output")
+	}
+}
+
+func TestHeadersDryRunRedactsValues(t *testing.T) {
+	f, out, errOut, _ := cmdutil.TestFactory(t, &core.CliConfig{
+		AppID: "test-app", AppSecret: "test-secret", Brand: core.BrandFeishu,
+	})
+	cmd := newTestApiCmd(f, nil)
+	cmd.SetArgs([]string{"GET", "/open-apis/test", "--headers",
+		`{"X-Lark-Helpdesk-Authorization":"private-header"}`, "--as", "user", "--dry-run"})
+	if err := cmd.Execute(); err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(out.String()+errOut.String(), "private-header") {
+		t.Fatal("header secret leaked in dry-run output")
+	}
+}
+
+func TestHeadersValidation(t *testing.T) {
+	for _, value := range []string{
+		`{"Authorization":"secret"}`, `{"hOsT":"secret"}`, `{"Cookie":"secret"}`,
+		`{"Content-Length":"1"}`, `{"Connection":"close"}`, `{"bad name":"secret"}`,
+		`{"X-Test":"secret\r\nInjected: yes"}`, `{"X-Test":42}`, `{"X-Test":"secret", "x-test":"other"}`,
+		`{"X-Test":"secret"`, `["secret"]`,
+	} {
+		t.Run(value, func(t *testing.T) {
+			f, _, _, _ := cmdutil.TestFactory(t, &core.CliConfig{AppID: "test-app"})
+			_, _, err := buildAPIRequest(&APIOptions{Factory: f, Ctx: context.Background(),
+				Method: "GET", Path: "/open-apis/test", Headers: value})
+			problem, ok := errs.ProblemOf(err)
+			if !ok || problem.Subtype != errs.SubtypeInvalidArgument {
+				t.Fatalf("expected typed validation error: %v", err)
+			}
+			if strings.Contains(err.Error(), "secret") {
+				t.Fatal("header value leaked in error")
+			}
+		})
+	}
+}
+
+func TestHeadersStdinConflicts(t *testing.T) {
+	for _, flag := range []string{"params", "data", "file"} {
+		t.Run(flag, func(t *testing.T) {
+			f, _, _, _ := cmdutil.TestFactory(t, &core.CliConfig{AppID: "test-app"})
+			opts := &APIOptions{Factory: f, Ctx: context.Background(), Method: "POST", Path: "/open-apis/test", Headers: "-"}
+			switch flag {
+			case "params":
+				opts.Params = "-"
+			case "data":
+				opts.Data = "-"
+			case "file":
+				opts.File = "upload=-"
+			}
+			if _, _, err := buildAPIRequest(opts); err == nil {
+				t.Fatal("expected stdin conflict")
+			}
+		})
+	}
+}
+
+func TestHeadersOptionPropagation(t *testing.T) {
+	f, _, _, _ := cmdutil.TestFactory(t, &core.CliConfig{AppID: "test-app"})
+	req, _, err := buildAPIRequest(&APIOptions{Factory: f, Ctx: context.Background(), Method: "GET",
+		Path: "/open-apis/test", Headers: `{"X-Lark-Helpdesk-Authorization":"private-header"}`})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var option larkcore.RequestOption
+	for _, apply := range req.ExtraOpts {
+		apply(&option)
+	}
+	if option.Header.Get("X-Lark-Helpdesk-Authorization") != "private-header" {
+		t.Fatal("header SDK option missing")
+	}
+}
